{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "vite",
  "installCommand": "npm install",
  "functions": {
    "api/state.js": { "maxDuration": 10 },
    "api/health.js": { "maxDuration": 10 },
    "api/events.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
