# Local dev: WebSocket relay port (Vite proxies /ws here)
WS_PORT=3001

# Optional: force sync transport — websocket (local dev) | sse (Vercel production)
# VITE_SYNC_MODE=websocket

# Optional: WebSocket on another host (not used on Vercel)
# VITE_WS_URL=wss://example.com/ws

# ——— Vercel production (required for live sync across browsers) ———
# Option A — Dashboard (recommended):
#   1. Vercel Dashboard → your project → Storage → Blob → Create → Connect
#   2. Enable Production + Preview, then Redeploy
#
# Option B — Manual token (if connect UI did not inject env vars):
#   Copy BLOB_READ_WRITE_TOKEN from the Blob store → Settings → Tokens
#   Vercel project → Settings → Environment Variables → add for Production → Redeploy
#
# Vercel may also set BLOB_STORE_ID + VERCEL_OIDC_TOKEN (OIDC auth) instead of the token above.
#
# Verify: https://your-app.vercel.app/api/health → storageReady: true, mode: "blob"
