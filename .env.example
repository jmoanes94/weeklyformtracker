# Local dev: WebSocket relay port (Vite proxies /ws here)
WS_PORT=3001

# Optional: force sync — poll (Vercel) | websocket (local dev)
# VITE_SYNC_MODE=websocket

# Optional: WebSocket on another host (not used on Vercel)
# VITE_WS_URL=wss://example.com/ws

# ——— Vercel production (required for live sync across browsers) ———
# 1. Vercel Dashboard → your project → Storage → KV → Create → Connect
# 2. Redeploy (adds KV_REST_API_URL and KV_REST_API_TOKEN automatically)
# 3. Test: https://your-app.vercel.app/api/health → storageReady: true
