# HTTP port for production Node server (npm start / Render)
PORT=3000

# Dev-only WebSocket relay port (Vite proxies /ws here)
WS_PORT=3001

# Optional: full WebSocket URL when WS runs on another host
# VITE_WS_URL=wss://your-app.onrender.com/ws

# Optional: force sync transport — websocket | sse
# VITE_SYNC_MODE=sse

# ——— Vercel live sync (required on Vercel; WebSockets are not supported there) ———
# Create a Vercel KV store (Storage → KV) or Upstash Redis, then add these env vars:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Upstash alternative names also work:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
